# Market-Terminal crypto sibling — freqtrade env (copy to .env; NEVER commit the filled file).
# freqtrade reads FREQTRADE__SECTION__KEY overrides on top of the JSON config, so all secrets
# live here (on this box only), not in the committed config.

# --- Binance exchange keys (spot, TRADE enabled, WITHDRAWALS DISABLED, IP-restricted) -------
# Leave DRY_RUN=true until you have validated in paper and are ready to go live. Going live =
# set FREQTRADE__DRY_RUN=false AND provide real keys below, then redeploy. Keys stay on THIS
# box — never in the market-terminal repo.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=
FREQTRADE__DRY_RUN=true

# --- api_server (FreqUI + REST) — the terminal's Crypto Bot panel reads these ---------------
# These are freqtrade's OWN REST credentials (not exchange keys). Put the same URL + username
# + password into the terminal at Settings -> Crypto Bot so its panel can display bot state.
FREQTRADE__API_SERVER__USERNAME=freqtrader
FREQTRADE__API_SERVER__PASSWORD=change-me-strong
# Generate: openssl rand -hex 32
FREQTRADE__API_SERVER__JWT_SECRET_KEY=
FREQTRADE__API_SERVER__WS_TOKEN=

# --- Market-Terminal signal source (read by user_data/strategies/terminal_features.py) ------
MT_API_URL=https://your-terminal-host
MT_API_TOKEN=
MT_QUOTE=USD
